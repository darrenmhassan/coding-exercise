        for label, ids in (("", s["problems"]), ("stretch ", s.get("stretch", []))):
            for pid in ids:
                p = byid.get(pid)
                done = [x for x in sched.get(pid, {}).get("attempts", []) if parse_date(x["date"]) >= sdate]
                tick = ("[x] r%d" % done[-1]["rating"]) if done else "[ ]   "
                print("     %s %s%s" % (tick, label, p["title"] if p else pid))


def cmd_list(a):
    sched = schedule()
    pat = resolve_pattern(a.pattern) if a.pattern else None
    for p in sorted(problems(), key=lambda p: (p["patterns"][0], p["lc"])):
        if pat and pat not in p["patterns"]:
            continue
        if a.core and not p["common"]:
            continue
        s = sched.get(p["id"])
        state = ("r%d due %s" % (s["last"]["rating"], s["due"].isoformat())) if s else "new"
        print("%-26s %4d %-52s %-6s %s%s  %s" % (p["patterns"][0], p["lc"], p["title"][:52], p["difficulty"],
              "C" if p["common"] else " ", "$" if p["premium"] else " ", state))
    print("\nC = commonly asked, $ = LeetCode premium")


def cmd_template(a):
