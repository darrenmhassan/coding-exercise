def cmd_drill_log(a):
    p = find_problem(a.id)
    guess = resolve_pattern(a.guess)
    if not guess:
        sys.exit("Unknown pattern '%s'. Valid: %s" % (a.guess, ", ".join(pattern_names())))
    retry = None
    if a.retry:
        retry = resolve_pattern(a.retry)
        if not retry:
            sys.exit("Unknown pattern '%s'. Valid: %s" % (a.retry, ", ".join(pattern_names())))
