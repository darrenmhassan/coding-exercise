MOCK_PROMPT = """You are a senior engineer at a large tech company running the coding round of a \
senior software engineer interview loop. Interview me on LeetCode {lc} "{title}", but reword it as a \
realistic industry scenario (services, orders, logs, deployments) and do NOT name the problem or the \
pattern. Rules:
- Present the problem in 3-5 sentences, deliberately leaving some requirements ambiguous.
- Answer my clarifying questions as an interviewer would; reveal constraints only when asked.
- Let me talk through my approach before coding; push back if I jump straight to code.
- I'll paste my Java code; review it like a whiteboard (no running): find bugs by tracing, ask about edge cases.
- Ask for time and space complexity, then 1-2 follow-ups (scale it up, make it concurrent, extend the API).
- Keep to 35 minutes of interaction; tell me when we're at 25 minutes.
- At the end score me 1-4 on: Problem Solving, Data Structures & Algorithms, Logical & Maintainable \
Code, and Communication, with one concrete thing to improve for each."""


def cmd_mock(a):
    if a.problem:
        p = find_problem(a.problem)
    else:
        sched = schedule()
        pool = [p for p in problems() if p["id"] not in sched and p["common"] and not p["premium"]]
        if not pool:
            pool = [p for p in problems() if not p["premium"]]
        p = random.choice(pool)
    prompt = MOCK_PROMPT.format(**p)
    copied = False
    if not a.show:
        try:
            subprocess.run(["pbcopy"], input=prompt.encode(), check=True)
            copied = True
        except (OSError, subprocess.CalledProcessError):
            pass
    if copied:
        print("\nMock-interviewer prompt copied to the clipboard (not shown, so the problem stays hidden).")
        print("Paste it into a new Claude chat.")
    else:
        print("\nPaste this into a new Claude chat:\n" + "-" * 60 + "\n" + prompt + "\n" + "-" * 60)
    start_attempt(p, "mock interview", 35, False, mock=True)
    print("  The file above is for your code; the problem title is printed in it, so don't open it until")
    print("  the interviewer has described the problem. Log with ./practise done afterwards.")


def cmd_add(a):
    bank = problems()
    slug = a.slug or ask("LeetCode slug (from the URL): ")
    if any(p["id"] == slug for p in bank):
        sys.exit("Already in the bank.")
    lc = int(a.lc if a.lc is not None else ask("LeetCode number: ", "0"))
    title = a.title or ask("Title: ", slug.replace("-", " ").title())
    diff = a.difficulty or ask("Difficulty (Easy/Medium/Hard) [Medium]: ", "Medium")
    pats = a.patterns
    if not pats:
        print_pattern_menu()
        pats = ask("Patterns (comma separated numbers/names, primary first): ", "")
    pats = [resolve_pattern(x) for x in pats.split(",")]
    if not pats or None in pats:
        sys.exit("Unrecognised pattern.")
    summary = a.summary or ask("One-line summary in your own words (used by drill): ", "")
    example = a.example or ask("Small example, input -> output (used by drill): ", "")
    core = a.core if a.core else (ask("Commonly asked? y/N: ", "n").lower().startswith("y"))
    bank.append({"id": slug, "lc": lc, "title": title, "url": "https://leetcode.com/problems/%s/" % slug,
                 "difficulty": diff.capitalize(), "patterns": pats, "common": bool(core),
                 "premium": bool(a.premium), "summary": summary, "example": example})
    save_json(BANK, bank)
    print("Added %s (%s)." % (title, ", ".join(pats)))


# ---------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(prog="practise", description="Pattern-based coding interview practice with spaced repetition.")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("next", help="start the next problem (plan > due reviews > weakest pattern)")
    s.add_argument("-p", "--pattern", help="restrict to a pattern (number or name)")
    s.add_argument("-s", "--session", help="plan session id (default: today's session if any)")
    s.add_argument("-t", "--timebox", type=int, default=DEFAULT_TIMEBOX)
    s.add_argument("--premium", action="store_true", help="allow LeetCode premium problems")
    s.add_argument("--easy", action="store_true", help="allow Easy problems for new picks")
    s.add_argument("--peek", action="store_true", help="show the pick without starting it")
    s.add_argument("--json", action="store_true", help="(for /coach) print the pick as JSON without starting it")
    s.add_argument("--no-open", action="store_true", help="don't open the editor")
    s.set_defaults(func=cmd_next)

    s = sub.add_parser("start", help="start a specific problem (slug, number or part of the slug)")
    s.add_argument("problem")
    s.add_argument("-t", "--timebox", type=int, default=DEFAULT_TIMEBOX)
    s.add_argument("--no-open", action="store_true")
    s.set_defaults(func=cmd_start)

    s = sub.add_parser("status", help="time elapsed on the current attempt")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("done", help="log the current attempt")
    s.add_argument("-r", "--rating", type=int, choices=[1, 2, 3, 4])
    s.add_argument("-u", "--used", help="pattern you used")
    s.add_argument("--hints", type=int)
    s.add_argument("-n", "--notes")
    s.add_argument("-m", "--minutes", type=int, help="override elapsed minutes")
    s.set_defaults(func=cmd_done)

    s = sub.add_parser("abandon", help="drop the current attempt without logging")
    s.set_defaults(func=cmd_abandon)

    s = sub.add_parser("drill", help="rapid pattern-recognition quiz")
    s.add_argument("-n", type=int, default=10)
    s.add_argument("-p", "--pattern")
    s.add_argument("--code", action="store_true", help="always show the template, even when right")
    s.add_argument("--no-code", action="store_true", help="never show templates (fast mode)")
    s.set_defaults(func=cmd_drill)

    s = sub.add_parser("drill-pick", help="(for the /drill Claude tutor) pick drill problems as JSON")
    s.add_argument("-n", type=int, default=10)
    s.add_argument("-p", "--pattern")
    s.set_defaults(func=cmd_drill_pick)

    s = sub.add_parser("drill-log", help="(for the /drill Claude tutor) record one drill answer")
    s.add_argument("--id", required=True)
    s.add_argument("--guess", required=True, help="the user's FIRST answer")
    s.add_argument("--hinted", action="store_true", help="they asked for a hint before answering")
    s.add_argument("--retry", help="their answer after the guiding question, if the first was wrong")
    s.add_argument("--session", help="session id from drill-pick")
    s.set_defaults(func=cmd_drill_log)

    s = sub.add_parser("drill-end", help="(for the /drill Claude tutor) close a drill session")
    s.add_argument("--session", required=True)
    s.add_argument("--stopped", action="store_true", help="ended before the last problem")
    s.set_defaults(func=cmd_drill_end)

    s = sub.add_parser("sessions", help="one row per completed drill session")
    s.add_argument("--last", type=int, help="only the most recent N")
    s.add_argument("--markdown", action="store_true", help="output a markdown table")
    s.set_defaults(func=cmd_sessions)

    s = sub.add_parser("template", help="show a pattern's signals and Java template")
    s.add_argument("pattern", nargs="?", help="number or name; omit to pick from the menu")
    s.set_defaults(func=cmd_template)

    s = sub.add_parser("weights", help="list weight profiles, or choose the one to use")
    s.add_argument("profile", nargs="?", help="profile name to make active")
    s.add_argument("--off", action="store_true", help="go back to the default weights")
    s.set_defaults(func=cmd_weights)

    s = sub.add_parser("stats", help="mastery by pattern")
    s.set_defaults(func=cmd_stats)

    s = sub.add_parser("report", help="markdown report (e.g. into your Obsidian vault)")
    s.add_argument("-o", "--out")
    s.set_defaults(func=cmd_report)

    s = sub.add_parser("plan", help="show the session plan and progress")
    s.set_defaults(func=cmd_plan)

    s = sub.add_parser("list", help="list the problem bank")
    s.add_argument("-p", "--pattern")
    s.add_argument("--core", action="store_true", help="commonly asked only")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("patterns", help="list patterns with weights and signals")
    s.set_defaults(func=cmd_patterns)

    s = sub.add_parser("mock", help="print a mock-interviewer prompt for Claude and start the timer")
    s.add_argument("problem", nargs="?")
    s.add_argument("--show", action="store_true", help="print the prompt instead of copying it")
    s.set_defaults(func=cmd_mock)

    s = sub.add_parser("add", help="add a problem to the bank")
    s.add_argument("--slug"); s.add_argument("--lc"); s.add_argument("--title")
    s.add_argument("--difficulty"); s.add_argument("--patterns"); s.add_argument("--summary"); s.add_argument("--example")
    s.add_argument("--core", action="store_true"); s.add_argument("--premium", action="store_true")
    s.set_defaults(func=cmd_add)

    a = ap.parse_args(argv)
    if not a.cmd:
        ap.print_help()
        return
    a.func(a)


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    main()
