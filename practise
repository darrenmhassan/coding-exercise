def cmd_drill_end(a):
    if not any(e["session"] == a.session and e["event"] == "start" for e in read_jsonl(SESSIONS_LOG)):
        sys.exit("No drill session '%s'." % a.session)
    end_session(a.session, "stopped" if a.stopped else "completed")
    print("session %s" % ("stopped" if a.stopped else "completed"))


def cmd_drill(a):
    sigs = {x["name"]: x["signals"] for x in patterns()}
    chosen = pick_drill(a.n, a.pattern)
    sid = start_session("cli", chosen, resolve_pattern(a.pattern) if a.pattern else None)
    quit_early = False
    print("\nName the pattern for each problem. Answer with a number or part of a name; 'q' quits.\n")
    print_pattern_menu()
    right = 0
    for n, p in enumerate(chosen, 1):
        print("\n[%d/%d] %s" % (n, len(chosen), p["summary"]))
        if p.get("example"):
            print(wrap("e.g. " + p["example"], "      "))
        while True:
            ans = ask("  pattern> ")
            if ans and ans.lower() == "q":
                chosen = chosen[:n - 1]
                break
            got = resolve_pattern(ans)
            if got:
                break
            print("  not recognised (try a number)")
        if ans and ans.lower() == "q":
            quit_early = True
            break
        ok = log_drill(p, got, session=sid)
        right += ok
        mark = "yes" if ok else "no, you said %s" % got
        print("  %s -> %s  (%s)" % (mark, " / ".join(p["patterns"]), p["title"]))
        primary = p["patterns"][0] if not ok or got not in p["patterns"] else got
        if not ok:
            if got:
                print(wrap("You said %s: %s" % (got, sigs.get(got, "")), "    "))
            show_pattern(primary, code=not a.no_code)
        elif a.code:
            show_pattern(primary)
        elif not a.no_code:
            more = ask("  enter = next, t = show the template: ", "")
            if more and more.lower().startswith("t"):
                show_pattern(primary)
    end_session(sid, "stopped" if quit_early else "completed")
    if chosen:
        print("\nScore: %d/%d" % (right, len(chosen)))
    if not quit_early:
        print("Session saved; ./practise sessions shows every completed session.")


def fmt(v, kind):
    if v is None:
        return "-"
    if kind == "pct":
        return "%d%%" % round(100 * v)
    if kind == "f1":
        return "%.1f" % v
    return str(v)


def stats_rows():
    st = pattern_stats()
    names = sorted(st, key=lambda n: (-st[n]["need"], n))
    rows = []
    for n in names:
        s = st[n]
        rows.append([n, "*" * s["weight"], "%d/%d" % (s["tried"], s["total"]), fmt(s["avg_rating"], "f1"),
                     fmt(s["recognised"], "pct"), fmt(s["drill_acc"], "pct") + ("" if not s["drills"] else " (%d)" % s["drills"]),
                     "%d/%d" % (s["drill_fixed"], s["drill_missed"]) if s["drill_missed"] else "",
                     str(s["due"]) if s["due"] else "", fmt(s["mastery"], "pct")])
    return rows


HEAD = ["pattern", "weight", "tried", "avg", "recog", "drill", "fixed", "due", "mastery"]


def cmd_weights(a):
    if a.off:
        if os.path.exists(ACTIVE_WEIGHTS):
            os.remove(ACTIVE_WEIGHTS)
        print("Using the default weights from bank/patterns.json.")
        return
    if a.profile:
        if a.profile not in weight_profiles():
            sys.exit("No profile '%s'. Create %s first." % (a.profile, os.path.join(WEIGHTS_DIR, a.profile + ".json")))
        with open(ACTIVE_WEIGHTS, "w") as f:
            f.write(a.profile + "\n")
        print("Using weight profile '%s'." % a.profile)
        return
    active, _ = active_weights()
    profiles = weight_profiles()
    if not profiles:
        print("No weight profiles. Add %s/<name>.json, e.g. {\"Trie\": 4}, then `practise weights <name>`." % WEIGHTS_DIR)
    for name in profiles:
        note = load_json(os.path.join(WEIGHTS_DIR, name + ".json"), {}).get("_note", "")
        print("%s %-12s %s" % ("*" if name == active else " ", name, note))
    print("\nActive: %s" % (active or "none (default weights)"))


def cmd_stats(a):
    rows = stats_rows()
    widths = [max(len(r[i]) for r in rows + [HEAD]) for i in range(len(HEAD))]
    line = lambda r: "  ".join(c.ljust(widths[i]) for i, c in enumerate(r))
    print("\nWeights: %s." % (active_weights()[0] or "default"))
    print("Sorted by need = weight x (1 - mastery). avg = mean of latest rating per problem (1-4).")
    print("recog = you named the right pattern when solving; drill = recognition drill accuracy (first answers).")
    print("fixed = drill misses you got right on the retry after a guiding question.\n")
    print(line(HEAD))
    print(line(["-" * w for w in widths]))
    for r in rows:
        print(line(r))
    att = read_jsonl(ATTEMPTS_LOG)
    if att:
        mins = sum(x["minutes"] for x in att)
        print("\n%d attempts, %d problems, %.1f hours. Last 5:" % (len(att), len({x["id"] for x in att}), mins / 60.0))
        byid = problems_by_id()
        for x in att[-5:]:
            print("  %s  %-45s r%d  %3d min  %s" % (x["date"], byid.get(x["id"], {"title": x["id"]})["title"][:45],
                                                     x["rating"], x["minutes"], x.get("notes", "")[:40]))


def cmd_report(a):
    rows = stats_rows()
    out = ["# Coding practice report", "", "_Generated %s by `practise report`._" % now_iso(), "",
           "| " + " | ".join(HEAD) + " |", "|" + "---|" * len(HEAD)]
    out += ["| " + " | ".join(r) + " |" for r in rows]
    srows = session_rows()
    if srows:
        out += ["", "## Drill sessions (completed)", "", "| " + " | ".join(SESSION_HEAD) + " |", "|" + "---|" * len(SESSION_HEAD)]
        out += ["| " + " | ".join(r) + " |" for r in srows]
    att = read_jsonl(ATTEMPTS_LOG)
    byid = problems_by_id()
    out += ["", "## Attempts", "", "| date | problem | rating | min | pattern ok | notes |", "|---|---|---|---|---|---|"]
    for x in reversed(att):
        p = byid.get(x["id"], {"title": x["id"], "url": ""})
        out.append("| %s | [%s](%s) | %d | %d | %s | %s |" % (
            x["date"], p["title"], p.get("url", ""), x["rating"], x["minutes"],
            "yes" if x.get("pattern_ok") else "no", (x.get("notes") or "").replace("|", "/")))
    text = "\n".join(out) + "\n"
    if a.out:
        with open(os.path.expanduser(a.out), "w") as f:
            f.write(text)
        print("Wrote " + a.out)
    else:
        print(text)


def cmd_plan(a):
    if not os.path.exists(PLAN):
        print("No plan. Copy plan.example.json to .practise/plan.json and edit the dates and problems.")
        return
    plan = load_json(PLAN, {"sessions": []})
    sched = schedule()
    byid = problems_by_id()
    print("\n" + plan.get("name", "Plan"))
    for s in plan["sessions"]:
        sdate = dt.date.fromisoformat(s["date"])
        marker = "  <- today" if sdate == today() else ""
        print("\n[%s] %s  %d min  %s%s" % (s["id"], s["date"], s["minutes"], s["focus"], marker))
        for st in s.get("steps", []):
