#!/usr/bin/env python3
"""practise: a spaced-repetition coding interview trainer organised by problem pattern.

State lives in plain files so it is easy to inspect, diff and extend:
  bank/problems.json     problem bank (id, LeetCode link, patterns, commonly-asked flag, summary, example)
  bank/patterns.json     patterns with a weight (interview likelihood) and recognition signals
  .practise/plan.json    optional dated practice sessions (local, not committed; see plan.example.json)
  .practise/weights/      optional named weight profiles, <name>.json = {"<pattern>": 1-5}, and
                          `active` naming the one in use (local, not committed; see `practise weights`)
  progress/attempts.jsonl  one JSON line per attempt (the schedule is derived from this)
                           progress/ and attempts/ stay on this machine (git-ignored)
  progress/drills.jsonl    one JSON line per pattern-recognition drill answer
  progress/drill_sessions.jsonl  start/end events of each drill session
  attempts/<date>_<id>/Solution.java   your written solutions
  .practise/current.json   the attempt in progress (not committed)

Python 3.8+ standard library only.
"""
import argparse
import datetime as dt
import json
import os
import random
import signal
import subprocess
import sys
import textwrap

ROOT = os.path.dirname(os.path.abspath(__file__))
BANK = os.path.join(ROOT, "bank", "problems.json")
PATTERNS = os.path.join(ROOT, "bank", "patterns.json")
PLAN = os.environ.get("PRACTISE_PLAN") or os.path.join(ROOT, ".practise", "plan.json")
WEIGHTS_DIR = os.path.join(ROOT, ".practise", "weights")
ACTIVE_WEIGHTS = os.path.join(WEIGHTS_DIR, "active")
PROGRESS = os.path.join(ROOT, "progress")
ATTEMPTS_LOG = os.path.join(PROGRESS, "attempts.jsonl")
DRILLS_LOG = os.path.join(PROGRESS, "drills.jsonl")
SESSIONS_LOG = os.path.join(PROGRESS, "drill_sessions.jsonl")
ATTEMPTS_DIR = os.path.join(ROOT, "attempts")
CURRENT = os.path.join(ROOT, ".practise", "current.json")
TEMPLATES = os.path.join(ROOT, "bank", "templates")

DEFAULT_TIMEBOX = 25
RATINGS = {
    1: "again  - could not solve it / needed the solution",
    2: "hard   - solved with hints, bugs, or well over time",
    3: "good   - solved within the timebox, minor slips",
    4: "easy   - fast, clean, optimal first time",
}
DIFF_ORDER = {"Medium": 0, "Hard": 1, "Easy": 2}


# ---------------------------------------------------------------- data access

def load_json(path, default=None):
    if not os.path.exists(path):
        return default
    with open(path) as f:
        return json.load(f)


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")


def read_jsonl(path):
    if not os.path.exists(path):
        return []
    out = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line:
                out.append(json.loads(line))
    return out


def append_jsonl(path, row):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(row, sort_keys=True) + "\n")


def problems():
    return load_json(BANK, [])


def problems_by_id():
    return {p["id"]: p for p in problems()}


def weight_profiles():
    if not os.path.isdir(WEIGHTS_DIR):
        return []
    return sorted(f[:-5] for f in os.listdir(WEIGHTS_DIR) if f.endswith(".json"))


def active_weights():
    """(name, path) of the weight profile in use, or (None, None). PRACTISE_WEIGHTS (a name or path) wins."""
    name = os.environ.get("PRACTISE_WEIGHTS")
    if name is None and os.path.exists(ACTIVE_WEIGHTS):
        with open(ACTIVE_WEIGHTS) as f:
            name = f.read().strip()
    if not name:
        return None, None
    path = name if name.endswith(".json") else os.path.join(WEIGHTS_DIR, name + ".json")
    if not os.path.exists(path):
        sys.exit("Weight profile '%s' not found (%s). See `practise weights`." % (name, path))
    return os.path.basename(path)[:-5], path


def patterns():
    pats = load_json(PATTERNS, [])
    _, path = active_weights()
    override = load_json(path, {}) if path else {}
    # Keys starting with "_" are notes; anything else must be a real pattern name, so a typo can't silently do nothing.
    unknown = {k for k in override if not k.startswith("_")} - {p["name"] for p in pats}
    if unknown:
        sys.exit("Unknown pattern(s) in %s: %s" % (path, ", ".join(sorted(unknown))))
    for p in pats:
        if p["name"] in override:
            p["weight"] = int(override[p["name"]])
    return pats


def pattern_names():
    return [p["name"] for p in patterns()]


def today():
    return dt.date.today()


def now_iso():
    return dt.datetime.now().replace(microsecond=0).isoformat()


def parse_date(s):
    return dt.date.fromisoformat(s[:10])


# ---------------------------------------------------------------- scheduling

def next_interval(prev, rating):
    """Days until the next review, SM-2 flavoured but simpler."""
    if prev == 0:
        return {1: 1, 2: 2, 3: 4, 4: 7}[rating]
    if rating == 1:
        return 1
    if rating == 2:
        return max(2, round(prev * 1.2))
    if rating == 3:
        return max(3, round(prev * 2.5))
    return max(5, round(prev * 3.5))


def schedule():
    """Per problem: attempts list, last rating, interval and due date, derived from the log."""
    sched = {}
    for a in read_jsonl(ATTEMPTS_LOG):
        s = sched.setdefault(a["id"], {"attempts": [], "interval": 0})
        s["interval"] = next_interval(s["interval"], a["rating"])
        s["attempts"].append(a)
        s["last"] = a
        s["due"] = parse_date(a["date"]) + dt.timedelta(days=s["interval"])
    return sched


def pattern_stats():
    """Mastery per pattern from last rating of each attempted problem plus drill accuracy."""
    bank = problems()
    sched = schedule()
    drills = read_jsonl(DRILLS_LOG)
    t = today()
    stats = {}
    for pat in patterns():
        name = pat["name"]
        probs = [p for p in bank if name in p["patterns"]]
        tried = [p for p in probs if p["id"] in sched]
        ratings = [sched[p["id"]]["last"]["rating"] for p in tried]
        recog = [sched[p["id"]]["last"].get("pattern_ok") for p in tried]
        recog = [r for r in recog if r is not None]
        d = [x for x in drills if x["answer"] == name]
        d_ok = sum(1 for x in d if x["correct"])
        solve = (sum(ratings) / (4.0 * len(ratings))) if ratings else 0.0
        drill_acc = (d_ok / len(d)) if d else None
        d_missed = [x for x in d if not x["correct"]]
        # Coverage matters: one good problem in a big pattern is not mastery.
        coverage = min(1.0, len(tried) / 3.0)
        mastery = solve * (0.5 + 0.5 * coverage)
        if drill_acc is not None:
            mastery = 0.8 * mastery + 0.2 * drill_acc
        stats[name] = {
            "weight": pat["weight"],
            "total": len(probs),
            "core": sum(1 for p in probs if p["common"]),
            "tried": len(tried),
            "avg_rating": (sum(ratings) / len(ratings)) if ratings else None,
            "recognised": (sum(1 for r in recog if r) / len(recog)) if recog else None,
            "drill_acc": drill_acc,
            "drills": len(d),
            "drill_missed": len(d_missed),
            "drill_fixed": sum(1 for x in d_missed if x.get("retry_correct")),
            "due": sum(1 for p in tried if sched[p["id"]]["due"] <= t),
            "mastery": mastery,
            "need": pat["weight"] * (1.0 - mastery),
        }
    return stats


def pick_next(pattern=None, allow_premium=False, session=None, include_easy=False):
    """Return (problem, reason)."""
    bank = problems()
    byid = {p["id"]: p for p in bank}
    sched = schedule()
    t = today()

    def ok(p):
        if pattern and pattern not in p["patterns"]:
            return False
        if p["premium"] and not allow_premium:
            return False
        return True

    # 1. The current plan session's list, in order, if not yet attempted on/after the session date.
    sess = find_session(session) if session is not None else None
    if sess:
        sdate = dt.date.fromisoformat(sess["date"])
        for pid in sess["problems"] + sess.get("stretch", []):
            p = byid.get(pid)
            done = pid in sched and any(parse_date(a["date"]) >= sdate for a in sched[pid]["attempts"])
            if p and not done and (not pattern or pattern in p["patterns"]):
                tag = "plan" if pid in sess["problems"] else "plan stretch"
                return p, "%s (%s session)" % (tag, sess["id"])

    # 2. Due reviews, most overdue first, heavier patterns first.
    weights = {x["name"]: x["weight"] for x in patterns()}
    due = []
    for pid, s in sched.items():
        p = byid.get(pid)
        if p and ok(p) and s["due"] <= t and parse_date(s["last"]["date"]) < t:
            overdue = (t - s["due"]).days
            w = max(weights.get(x, 1) for x in p["patterns"])
            due.append((-overdue, s["last"]["rating"], -w, p))
    if due:
        due.sort(key=lambda x: (x[0], x[1], x[2]))
        p = due[0][3]
        return p, "review due (last rated %d)" % sched[p["id"]]["last"]["rating"]

    # 3. New problem from the pattern with the highest need.
    stats = pattern_stats()
    cands = [p for p in bank if ok(p) and p["id"] not in sched]
    if not include_easy:
        non_easy = [p for p in cands if p["difficulty"] != "Easy"]
        cands = non_easy or cands
    if not cands:
        return None, "nothing left to practise with these filters"
    pats = [pattern] if pattern else sorted(stats, key=lambda n: -stats[n]["need"])
    for name in pats:
        pool = [p for p in cands if p["patterns"][0] == name] or [p for p in cands if name in p["patterns"]]
        if pool:
            pool.sort(key=lambda p: (not p["common"], DIFF_ORDER[p["difficulty"]], p["lc"]))
            return pool[0], "new: weakest high-value pattern"
    return cands[0], "new"


def find_session(sid):
    plan = load_json(PLAN, {"sessions": []})
    sessions = plan.get("sessions", [])
    if sid == "auto":
        t = today().isoformat()
        for s in sessions:
            if s["date"] == t:
                return s
        return None
    for s in sessions:
        if s["id"] == sid:
            return s
    sys.exit("No session '%s' in plan.json" % sid)


# ---------------------------------------------------------------- helpers

def resolve_pattern(text, names=None):
    names = names or pattern_names()
    text = (text or "").strip()
    if not text:
        return None
    if text.isdigit():
        i = int(text) - 1
        return names[i] if 0 <= i < len(names) else None
    low = text.lower()
    exact = [n for n in names if n.lower() == low]
    if exact:
        return exact[0]
    hits = [n for n in names if low in n.lower()]
    if len(hits) == 1:
        return hits[0]
    words = [n for n in names if all(w in n.lower() for w in low.split())]
    return words[0] if len(words) == 1 else None


def template_path(name):
    slug = "".join(ch if ch.isalnum() else "-" for ch in name.lower()).strip("-")
    while "--" in slug:
        slug = slug.replace("--", "-")
    return os.path.join(TEMPLATES, slug + ".java")


def show_pattern(name, signals=True, code=True, indent="    "):
    """Print a pattern's recognition signals and its Java template."""
    pat = next((p for p in patterns() if p["name"] == name), None)
    if pat and signals:
        print(wrap("%s - when to use: %s" % (name, pat["signals"]), indent))
    path = template_path(name)
    if code and os.path.exists(path):
        print()
        with open(path) as f:
            for line in f.read().rstrip().splitlines():
                print(indent + "| " + line)
        print()


def pattern_grid(indent="  "):
    names = pattern_names()
    cols = 3
    rows = (len(names) + cols - 1) // cols
    lines = []
    for r in range(rows):
        line = ""
        for c in range(cols):
            i = r + c * rows
            if i < len(names):
                line += ("%2d %-26s" % (i + 1, names[i]))
        lines.append((indent + line).rstrip())
    return "\n".join(lines)


def print_pattern_menu():
    print(pattern_grid())


def ask(prompt, default=None):
    try:
        v = input(prompt)
    except EOFError:
        # No terminal (e.g. run by a slash command): fail fast instead of looping on a required value.
        if default is None:
            sys.exit("\nNo input available for '%s'; pass it as a flag (see --help)." % prompt.strip())
        v = ""
    v = v.strip()
    return v if v else default


def wrap(s, indent="  "):
    return textwrap.fill(s, width=88, initial_indent=indent, subsequent_indent=indent)


def find_problem(ref):
    byid = problems_by_id()
    if ref in byid:
        return byid[ref]
    if ref.isdigit():
        for p in byid.values():
            if p["lc"] == int(ref):
                return p
    hits = [p for p in byid.values() if ref.lower() in p["id"]]
    if len(hits) == 1:
        return hits[0]
    if hits:
        sys.exit("Ambiguous: " + ", ".join(p["id"] for p in hits))
    sys.exit("No problem matching '%s' (see ./practise list)" % ref)


def scaffold(p, timebox):
    d = os.path.join(ATTEMPTS_DIR, "%s_%s" % (today().isoformat(), p["id"]))
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, "Solution.java")
    if not os.path.exists(path):
        with open(path, "w") as f:
            f.write(textwrap.dedent("""\
                /*
                 * %(lc)s. %(title)s  [%(difficulty)s]
                 * %(url)s
                 *
                 * Timebox %(tb)d min. Write it here WITHOUT running it (like the interview editor),
                 * then paste into LeetCode to verify. Talk out loud as you go.
                 *
                 * 1. Clarify: inputs, sizes, edge cases, return value, assumptions
                 *
                 *
                 * 2. Approach: which pattern and why; brute force first, then optimal; time/space
                 *
                 *
                 * 3. Code   4. Test: trace one example by hand, then edge cases   5. Optimise
                 */
                import java.util.*;

                class Solution {

                }
                """) % dict(p, tb=timebox))
    return path


def start_attempt(p, reason, timebox, open_editor, mock=False):
    cur = load_json(CURRENT)
    if cur:
        print("Note: replacing unfinished attempt '%s'." % cur["id"])
    path = scaffold(p, timebox)
    save_json(CURRENT, {"id": p["id"], "started": now_iso(), "timebox": timebox, "file": path,
                        "reason": reason, "mock": mock})
    print()
    print("  %s. %s  [%s]%s" % (p["lc"], p["title"], p["difficulty"], "  (premium)" if p["premium"] else ""))
    print("  " + p["url"])
    print("  why: " + reason)
    print("  timebox: %d min, started %s" % (timebox, dt.datetime.now().strftime("%H:%M")))
    print("  file: " + os.path.relpath(path, ROOT))
    print()
    print("  When finished: ./practise done   (or ./practise status to see elapsed time)")
    if open_editor:
        ed = os.environ.get("VISUAL") or os.environ.get("EDITOR")
        try:
            if ed:
                subprocess.Popen(ed.split() + [path])
            elif sys.platform == "darwin":
                subprocess.Popen(["open", "-t", path])
        except OSError as e:
            print("  (could not open editor: %s)" % e)


# ---------------------------------------------------------------- commands

def cmd_next(a):
    session = a.session if a.session else ("auto" if not a.pattern else None)
    pat = resolve_pattern(a.pattern) if a.pattern else None
    if a.pattern and not pat:
        sys.exit("Unknown pattern '%s'. ./practise patterns lists them." % a.pattern)
    p, reason = pick_next(pat, a.premium, session, a.easy)
    if not p:
        sys.exit(reason)
    if a.json:
        sigs = {x["name"]: x["signals"] for x in patterns()}
        q = dict(p, reason=reason, signals={n: sigs[n] for n in p["patterns"]})
        print(json.dumps({"grid": pattern_grid(""), "problem": q}, indent=1))
        return
    if a.peek:
        print("%s  (%s)  %s" % (p["title"], reason, p["url"]))
        return
    start_attempt(p, reason, a.timebox, not a.no_open)


def cmd_start(a):
    p = find_problem(a.problem)
    start_attempt(p, "chosen", a.timebox, not a.no_open)


def cmd_status(a):
    cur = load_json(CURRENT)
    if not cur:
        print("No attempt in progress. ./practise next")
        return
    started = dt.datetime.fromisoformat(cur["started"])
    mins = (dt.datetime.now() - started).total_seconds() / 60
    left = cur["timebox"] - mins
    p = problems_by_id().get(cur["id"], {"title": cur["id"]})
    print("%s: %.0f min elapsed, %s" % (p["title"], mins,
          ("%.0f min left" % left) if left >= 0 else ("%.0f min OVER" % -left)))


def cmd_done(a):
    cur = load_json(CURRENT)
    if not cur:
        sys.exit("No attempt in progress.")
    p = problems_by_id()[cur["id"]]
    started = dt.datetime.fromisoformat(cur["started"])
    minutes = a.minutes if a.minutes is not None else round((dt.datetime.now() - started).total_seconds() / 60)
    print("\n  %s - %d min (timebox %d)" % (p["title"], minutes, cur["timebox"]))

    used = a.used
    if used is None:
        print("\n  Which pattern did you use?")
        print_pattern_menu()
        while True:
            used = resolve_pattern(ask("  number or name: "))
            if used:
                break
            print("  not recognised, try again")
    else:
        used = resolve_pattern(used) or used
    pattern_ok = used in p["patterns"]

    rating = a.rating
    if rating is None:
        print()
        for k, v in RATINGS.items():
            print("  %d %s" % (k, v))
        while rating not in RATINGS:
            r = ask("  rating 1-4: ")
            rating = int(r) if r and r.isdigit() else None
    hints = a.hints if a.hints is not None else int(ask("  hints used [0]: ", "0"))
    notes = a.notes if a.notes is not None else ask("  notes (mistakes, insight; enter to skip): ", "")

    row = {"id": p["id"], "date": today().isoformat(), "started": cur["started"], "minutes": minutes,
           "timebox": cur["timebox"], "rating": rating, "pattern_used": used, "pattern_ok": pattern_ok,
           "hints": hints, "notes": notes, "file": os.path.relpath(cur["file"], ROOT), "mock": cur.get("mock", False)}
    append_jsonl(ATTEMPTS_LOG, row)
    os.remove(CURRENT)

    s = schedule()[p["id"]]
    print()
    print("  Pattern(s): %s  %s" % (", ".join(p["patterns"]), "- you got it" if pattern_ok else "- you used " + used))
    if not pattern_ok:
        print()
        show_pattern(p["patterns"][0])
    else:
        print("  (./practise template %s shows the reference template)" % ("\"%s\"" % used if " " in used else used))
    print("  Next review: %s (in %d days)" % (s["due"].isoformat(), s["interval"]))


def cmd_abandon(a):
    if os.path.exists(CURRENT):
        os.remove(CURRENT)
        print("Dropped the current attempt (nothing logged).")


def pick_drill(n, pattern=None):
    """Weighted sample by pattern need (as in `next`), previously missed problems more, recently seen ones less."""
    pat = resolve_pattern(pattern) if pattern else None
    if pattern and not pat:
        sys.exit("Unknown pattern '%s'." % pattern)
    bank = [p for p in problems() if pat is None or pat in p["patterns"]]
    # The floor keeps strong patterns in rotation occasionally instead of dropping out entirely.
    weights = {name: s["need"] + 0.5 for name, s in pattern_stats().items()}
    missed = {}
    for d in read_jsonl(DRILLS_LOG):
        missed[d["id"]] = missed.get(d["id"], 0) + (0 if d["correct"] else 1)
    last_seen = {}
    for d in read_jsonl(DRILLS_LOG):
        last_seen[d["id"]] = parse_date(d["date"])
    pool = list(bank)
    pw = []
    for p in pool:
        w = max(weights[x] for x in p["patterns"]) + 2 * missed.get(p["id"], 0)
        seen = last_seen.get(p["id"])
        if seen is not None:
            age = (today() - seen).days
            w *= 0.1 if age < 1 else 0.3 if age < 3 else 1.0   # avoid repeats across restarts
        pw.append(w)
    rng = random.Random()
    chosen = []
    for _ in range(min(n, len(pool))):
        i = rng.choices(range(len(pool)), weights=pw)[0]
        chosen.append(pool.pop(i))
        pw.pop(i)
    return chosen


def log_drill(p, guess, hinted=False, source="cli", session=None, retry=None):
    ok = guess in p["patterns"]
    row = {"id": p["id"], "date": today().isoformat(), "guess": guess,
           "answer": p["patterns"][0], "correct": ok, "hinted": hinted, "source": source}
    if session:
        row["session"] = session
    # Score stays on the first answer; the retry after the tutor's guiding question is kept
    # separately so recovering with a nudge is visible without inflating accuracy.
    if retry and not ok:
        row["retry"] = retry
        row["retry_correct"] = retry in p["patterns"]
    append_jsonl(DRILLS_LOG, row)
    return ok


def start_session(source, chosen, pattern=None):
    sid = dt.datetime.now().strftime("%Y%m%d-%H%M%S-") + "%04x" % random.getrandbits(16)
    append_jsonl(SESSIONS_LOG, {"session": sid, "event": "start", "at": now_iso(), "source": source,
                                "planned": len(chosen), "pattern": pattern, "ids": [p["id"] for p in chosen]})
    return sid


def end_session(sid, status):
    append_jsonl(SESSIONS_LOG, {"session": sid, "event": "end", "at": now_iso(), "status": status})


def completed_sessions():
    """One summary per COMPLETED drill session, oldest first. Each session is kept separate."""
    starts, ends = {}, {}
    for e in read_jsonl(SESSIONS_LOG):
        (starts if e["event"] == "start" else ends)[e["session"]] = e
    answers = {}
    for d in read_jsonl(DRILLS_LOG):
        if d.get("session"):
            answers.setdefault(d["session"], []).append(d)
    out = []
    for sid, st in starts.items():
        en = ends.get(sid)
        if not en or en.get("status") != "completed":
            continue
        rows = answers.get(sid, [])
        t0, t1 = dt.datetime.fromisoformat(st["at"]), dt.datetime.fromisoformat(en["at"])
        missed = [d["answer"] for d in rows if not d["correct"]]
        out.append({
            "session": sid, "start": t0, "minutes": max(0, round((t1 - t0).total_seconds() / 60)),
            "source": st.get("source", "?"), "focus": st.get("pattern") or "all",
            "planned": st.get("planned", len(rows)), "answered": len(rows),
            "correct": sum(1 for d in rows if d["correct"]),
            "hinted": sum(1 for d in rows if d.get("hinted")), "missed": missed,
            "fixed": sum(1 for d in rows if d.get("retry_correct")),
        })
    out.sort(key=lambda x: x["start"])
    return out


SESSION_HEAD = ["#", "date", "time", "via", "focus", "answered", "correct", "score", "fixed after hint", "hinted", "min", "missed (correct pattern)"]


def session_rows():
    rows = []
    for i, x in enumerate(completed_sessions(), 1):
        score = (x["correct"] / x["answered"]) if x["answered"] else None
        missed = ", ".join(sorted(set(x["missed"]), key=x["missed"].index)) or "-"
        rows.append([str(i), x["start"].strftime("%Y-%m-%d"), x["start"].strftime("%H:%M"), x["source"],
                     x["focus"], "%d/%d" % (x["answered"], x["planned"]), str(x["correct"]),
                     fmt(score, "pct"),
                     "%d/%d" % (x["fixed"], len(x["missed"])) if x["missed"] else "-", str(x["hinted"]) if x["hinted"] else "-", str(x["minutes"]), missed])
    return rows


def cmd_sessions(a):
